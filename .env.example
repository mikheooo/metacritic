# Host port mappings (if running docker compose alongside other services)
POSTGRES_PORT=5433
REDIS_PORT=6380

# Database (PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname> for async FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/metacritic
# Sync URL used by Alembic migrations and sync workers if needed:
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/metacritic

# Redis Broker & Celery Result Backend
REDIS_URL=redis://localhost:6380/0

# Application Configuration
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# LLM Summarization Configuration
# Provider options: openrouter (production default), openai, fake (local/tests)
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
SUMMARY_LANGUAGE=ru
SUMMARY_PROMPT_VERSION=v1

# OpenRouter Configuration (when LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct OpenAI Configuration (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Future External Services (YouTube)
# YOUTUBE_API_KEY=AIzaSy...

