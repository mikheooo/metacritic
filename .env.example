# Host port mappings (if running docker compose alongside other services)
POSTGRES_PORT=5433
REDIS_PORT=6380

# Database (PostgreSQL with pgvector)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname> for async FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/metacritic
# Sync URL used by Alembic migrations and sync workers:
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/metacritic

# Redis Broker & Celery Result Backend
REDIS_URL=redis://localhost:6380/0

# Application Configuration
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Crawler & Scheduler Configuration
CRAWL_SCHEDULE_ENABLED=true
CRAWL_BATCH_LIMIT=20
CRAWLER_RATE_LIMIT_DELAY=0.5
CRAWLER_TIMEOUT=15.0
CRAWLER_LOCK_TIMEOUT=600
MANUAL_RUN_COOLDOWN_SECONDS=60
CELERY_TIMEZONE=UTC
CRAWL_SCHEDULE_MINUTE=0

# AI LLM Summarization Configuration
# Provider options: openrouter (production default), openai, fake (local/tests)
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
SUMMARY_LANGUAGE=ru
SUMMARY_PROMPT_VERSION=v1

# OpenRouter Configuration (when LLM_PROVIDER=openrouter or EMBEDDING_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct OpenAI Configuration (when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# AI Semantic Embeddings & Similar Games (pgvector)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
SIMILAR_GAMES_LIMIT=5

# YouTube Integration (Let's Play bonus)
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=AIzaSyYourYouTubeApiKeyHere
YOUTUBE_SEARCH_RESULTS_LIMIT=10
YOUTUBE_TRANSCRIPT_LANGUAGES=["en","ru"]
YOUTUBE_SEARCH_REFRESH_HOURS=24
YOUTUBE_PROMPT_VERSION=v1

