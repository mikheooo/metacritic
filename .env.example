# Host port mappings (if running docker compose alongside other services)
POSTGRES_PORT=5433
REDIS_PORT=6380

# Database (PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname> for async FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/metacritic
# Sync URL used by Alembic migrations and sync workers if needed:
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/metacritic

# Redis Broker & Celery Result Backend
REDIS_URL=redis://localhost:6380/0

# Application Configuration
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Future External Services (Not used in Stage 1)
# OPENAI_API_KEY=sk-...
# YOUTUBE_API_KEY=AIzaSy...
